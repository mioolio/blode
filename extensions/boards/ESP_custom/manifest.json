{
  "id": "ESP_custom",
  "name": "ESP 自定义",
  "version": "1.0.0",
  "apiVersion": 2,
  "runtimeApiVersion": 2,
  "kind": "board",
  "entry": "device/adapter.ts",
  "runtime": "runtime/index.ts",
  "transport": "serial",
  "vendor": "Espressif",
  "descriptionKey": "boards.espCustomDescription",
  "capabilities": ["compile", "validate-firmware", "flash", "probe", "serial", "layout"],
  "sourceInputs": [],
  "support": {
    "chips": ["ESP (user configured)"],
    "families": ["Espressif"],
    "status": "experimental",
    "notes": "Uses the installed esptool and Arduino core. Chip and FQBN are user configured."
  },
  "defaultConfig": {
    "version": 1,
    "name": "firmware",
    "boardId": "ESP_custom",
    "port": "",
    "baudRate": 460800,
    "flashSize": 8388608,
    "partitions": [
      {
        "id": "bootloader",
        "name": "bootloader",
        "type": "system",
        "offset": 0,
        "size": 32768
      },
      {
        "id": "partition-table",
        "name": "partition_table",
        "type": "system",
        "offset": 32768,
        "size": 4096
      },
      {
        "id": "nvs",
        "name": "nvs",
        "type": "data",
        "offset": 36864,
        "size": 24576
      },
      {
        "id": "phy",
        "name": "phy_init",
        "type": "data",
        "offset": 61440,
        "size": 4096
      },
      {
        "id": "app",
        "name": "factory",
        "type": "app",
        "offset": 65536,
        "size": 3145728
      },
      {
        "id": "coredump",
        "name": "coredump",
        "type": "data",
        "offset": 3211264,
        "size": 65536
      },
      {
        "id": "filesystem",
        "name": "spiffs",
        "type": "data",
        "offset": 3276800,
        "size": 5111808
      }
    ],
    "toolchain": {
      "mode": "managed",
      "arduinoCli": "",
      "python": "",
      "additionalUrls": ["https://espressif.github.io/arduino-esp32/package_esp32_index.json"],
      "fqbn": "esp32:esp32:esp32s3"
    },
    "runtime": {
      "values": {
        "chip": "auto",
        "fqbn": "esp32:esp32:esp32s3",
        "bootloaderAddress": "auto",
        "partitionAddress": "0x8000",
        "flashAddress": "0x0",
        "ramSize": 327680,
        "buildExecutable": "",
        "buildArguments": "[]",
        "firmware": "firmware.bin"
      }
    }
  },
  "compiler": {
    "mode": "runtime",
    "managedTools": [
      {
        "id": "arduino-cli",
        "name": "Arduino CLI"
      },
      {
        "id": "esptool",
        "name": "esptool"
      }
    ]
  },
  "debugger": {
    "mode": "none"
  },
  "layout": {
    "flashBaseAddress": 0,
    "recommendedFlashSizes": [1048576, 2097152, 4194304, 8388608, 16777216],
    "ramSize": 327680
  },
  "constraints": {
    "notes": []
  },
  "ui": {
    "fields": [
      {
        "id": "chip",
        "label": "esptool 芯片（auto 自动检测）",
        "type": "text",
        "default": "auto"
      },
      {
        "id": "fqbn",
        "label": "Arduino FQBN",
        "type": "text",
        "default": "esp32:esp32:esp32s3"
      },
      {
        "id": "bootloaderAddress",
        "label": "Bootloader 地址",
        "type": "text",
        "default": "auto"
      },
      {
        "id": "partitionAddress",
        "label": "分区表地址",
        "type": "text",
        "default": "0x8000"
      },
      {
        "id": "flashAddress",
        "label": "Flash 基址",
        "type": "text",
        "default": "0x0"
      },
      {
        "id": "ramSize",
        "label": "RAM 容量（字节）",
        "type": "number",
        "min": 0,
        "max": 4294967295,
        "default": 327680
      },
      {
        "id": "buildExecutable",
        "label": "自定义构建程序",
        "type": "text",
        "default": ""
      },
      {
        "id": "buildArguments",
        "label": "构建参数（JSON 数组）",
        "type": "text",
        "default": "[]"
      },
      {
        "id": "firmware",
        "label": "构建产物路径",
        "type": "text",
        "default": "firmware.bin"
      }
    ],
    "hiddenCapabilities": []
  },
  "languages": {
    "mode": "declared",
    "default": "cpp",
    "entries": [
      {
        "id": "c",
        "editorLanguage": "cpp",
        "extensions": [".c"],
        "catalogs": []
      },
      {
        "id": "cpp",
        "editorLanguage": "cpp",
        "extensions": [".cpp", ".h", ".hpp", ".ino", ".cc", ".cxx"],
        "catalogs": []
      }
    ]
  }
}

# IDF 5.1.4 derives UART Ctrl+C from an exception frame that may contain a stale
# exception cause. Report SIGINT for that UART path, preserving panic handling.
function(blode_prepare_uart_gdbstub idf_path output_directory)
    set(component "${idf_path}/components/esp_gdbstub")
    set(source_file "${component}/src/gdbstub.c")
    if(NOT EXISTS "${source_file}")
        message(FATAL_ERROR "ESP-IDF v5.1.4 esp_gdbstub source is missing")
    endif()
    file(READ "${source_file}" original)
    string(REPLACE "\r\n" "\n" original "${original}")
    string(SHA256 source_hash "${original}")
    if(NOT source_hash STREQUAL "5b7184151818da88c87f0ba133c8410699a8b6e95aa1179b5590c754c1292469")
        message(FATAL_ERROR "ESP-IDF esp_gdbstub differs from v5.1.4; review the UART SIGINT patch before building")
    endif()
    set(before "    int doDebug = esp_gdbstub_getfifo();\n    s_scratch.signal = esp_gdbstub_get_signal(regs_frame);")
    set(after "    int doDebug = esp_gdbstub_getfifo();\n    s_scratch.signal = 2; /* UART Ctrl+C: SIGINT, not a CPU exception. */")
    string(FIND "${original}" "${before}" patch_offset)
    if(patch_offset EQUAL -1)
        message(FATAL_ERROR "ESP-IDF v5.1.4 UART signal assignment was not found")
    endif()
    string(REPLACE "${before}" "${after}" patched "${original}")
    # Generated component overrides the SDK component only for this project.
    file(MAKE_DIRECTORY "${output_directory}")
    file(COPY "${component}/" DESTINATION "${output_directory}")
    file(READ "${output_directory}/src/gdbstub.c" previous)
    if(NOT previous STREQUAL patched)
        file(WRITE "${output_directory}/src/gdbstub.c" "${patched}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_file}")
endfunction()

  "snippets": [
    {
      "name": "include",
      "kind": "snippet",
      "detail": "#include \"header.h\"",
      "insertText": "#include \"${1:header.h}\""
    },
    {
      "name": "define",
      "kind": "snippet",
      "detail": "#define NAME value",
      "insertText": "#define ${1:NAME} ${2:value}"
    },
    {
      "name": "if",
      "kind": "snippet",
      "detail": "if (condition) { ... }",
      "insertText": "if (${1:condition}) {\n\t${2}\n}"
    },
    {
      "name": "ifelse",
      "kind": "snippet",
      "detail": "if / else",
      "insertText": "if (${1:condition}) {\n\t${2}\n} else {\n\t${3}\n}"
    },
    {
      "name": "for",
      "kind": "snippet",
      "detail": "for (init; condition; step)",
      "insertText": "for (int ${1:i} = 0; ${1:i} < ${2:count}; ${1:i}++) {\n\t${3}\n}"
    },
    {
      "name": "while",
      "kind": "snippet",
      "detail": "while (condition) { ... }",
      "insertText": "while (${1:condition}) {\n\t${2}\n}"
    },
    {
      "name": "do while",
      "kind": "snippet",
      "detail": "do { ... } while (condition)",
      "insertText": "do {\n\t${1}\n} while (${2:condition});"
    },
    {
      "name": "switch",
      "kind": "snippet",
      "detail": "switch / case / default",
      "insertText": "switch (${1:value}) {\n\tcase ${2:0}:\n\t\t${3:break;}\n\tdefault:\n\t\tbreak;\n}"
    },
    {
      "name": "typedef struct",
      "kind": "snippet",
      "detail": "typedef struct { ... } Name;",
      "insertText": "typedef struct {\n\t${1:fields}\n} ${2:Name};"
    },
    {
      "name": "typedef enum",
      "kind": "snippet",
      "detail": "typedef enum { ... } Name;",
      "insertText": "typedef enum {\n\t${1:VALUE} = 0,\n} ${2:Name};"
    }
  ],
  "rules": [
    {
      "id": "removed-gets",
      "kind": "call",
      "names": ["gets"],
      "severity": "warning",
      "message": "gets 无法限制输入长度，请使用 fgets。",
      "enabled": true
    },
    {
      "id": "c11-syntax",
      "kind": "call",
      "names": ["_Generic", "_Static_assert", "_Alignof", "_Alignas"],
      "severity": "warning",
      "message": "此语法需要 C11 或更新标准。",
      "enabled": true
    },
    {
      "id": "c23-syntax",
      "kind": "call",
      "names": ["typeof", "typeof_unqual", "_BitInt", "static_assert", "alignof", "alignas"],
      "severity": "warning",
      "message": "此标准语法需要 C23；编译器扩展可另行支持。",
      "enabled": true
    }
  ]
}

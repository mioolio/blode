{
  "id": "STM_custom",
  "name": "STM 自定义",
  "version": "1.0.0",
  "apiVersion": 2,
  "runtimeApiVersion": 2,
  "kind": "board",
  "entry": "device/adapter.ts",
  "runtime": "runtime/index.ts",
  "transport": "stlink",
  "vendor": "STMicroelectronics",
  "descriptionKey": "boards.stmCustomDescription",
  "capabilities": ["compile", "validate-firmware", "flash", "probe", "serial", "layout"],
  "sourceInputs": [],
  "support": {
    "chips": ["STM32 (user configured)"],
    "families": ["STM32"],
    "status": "experimental",
    "notes": "Uses the installed ST-Link tools. Build command and memory map are user configured."
  },
  "defaultConfig": {
    "version": 1,
    "name": "firmware",
    "boardId": "STM_custom",
    "port": "",
    "baudRate": 115200,
    "flashSize": 65536,
    "partitions": [
      {
        "id": "firmware",
        "name": "firmware",
        "type": "app",
        "offset": 0,
        "size": 65536
      }
    ],
    "programmer": {
      "transport": "stlink",
      "serialNumber": "",
      "frequencyKhz": 1800
    },
    "toolchain": {
      "mode": "managed",
      "arduinoCli": "",
      "python": "",
      "additionalUrls": [],
      "fqbn": "",
      "stlinkDirectory": "",
      "armCompilerDirectory": ""
    },
    "runtime": {
      "values": {
        "chip": "STM32",
        "flashAddress": "0x08000000",
        "ramSize": 20480,
        "buildExecutable": "",
        "buildArguments": "[]",
        "firmware": "firmware.bin"
      }
    }
  },
  "compiler": {
    "mode": "runtime",
    "managedTools": [
      {
        "id": "stlink",
        "name": "ST-Link"
      }
    ]
  },
  "debugger": {
    "mode": "none"
  },
  "layout": {
    "flashBaseAddress": 134217728,
    "recommendedFlashSizes": [65536, 131072, 262144, 524288, 1048576],
    "ramSize": 20480
  },
  "constraints": {
    "notes": []
  },
  "ui": {
    "fields": [
      {
        "id": "chip",
        "label": "目标型号",
        "type": "text",
        "default": "STM32"
      },
      {
        "id": "flashAddress",
        "label": "Flash 基址",
        "type": "text",
        "default": "0x08000000"
      },
      {
        "id": "ramSize",
        "label": "RAM 容量（字节）",
        "type": "number",
        "min": 0,
        "max": 4294967295,
        "default": 20480
      },
      {
        "id": "buildExecutable",
        "label": "自定义构建程序",
        "type": "text",
        "default": ""
      },
      {
        "id": "buildArguments",
        "label": "构建参数（JSON 数组）",
        "type": "text",
        "default": "[]"
      },
      {
        "id": "firmware",
        "label": "构建产物路径",
        "type": "text",
        "default": "firmware.bin"
      }
    ],
    "hiddenCapabilities": []
  },
  "languages": {
    "mode": "declared",
    "default": "c",
    "entries": [
      {
        "id": "c",
        "editorLanguage": "cpp",
        "extensions": [".c"],
        "catalogs": []
      },
      {
        "id": "cpp",
        "editorLanguage": "cpp",
        "extensions": [".cpp", ".h", ".hpp", ".ino", ".cc", ".cxx"],
        "catalogs": []
      }
    ]
  }
}

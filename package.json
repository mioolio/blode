{
  "name": "blode-studio",
  "productName": "Blode Studio",
  "version": "0.3.4-3",
  "releaseVersion": "0.3.4.3",
  "author": "mioolio",
  "description": "Modular microcontroller development studio",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "postinstall": "node scripts/windows-runtime.mjs",
    "dev": "node scripts/dev.mjs",
    "repair:permissions": "node scripts/windows-runtime.mjs",
    "build": "npm run typecheck && node scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/register-styles.mjs --test tests/*.test.ts",
    "prestart": "node scripts/windows-runtime.mjs",
    "start": "electron .",
    "package": "npm run package:lite",
    "package:desktop": "npm run package:lite",
    "package:lite": "node scripts/package-desktop.mjs",
    "package:full": "node scripts/package-desktop.mjs --full",
    "mcp": "tsx scripts/mcp-bridge.ts",
    "fetch:clangd": "tsx scripts/fetch-clangd.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "tsx scripts/web-server.ts",
    "web:build": "node scripts/build-web.mjs",
    "web:start": "node dist/web-server.cjs",
    "package:web": "tsx scripts/package-web.ts",
    "package:runtime": "tsx scripts/package-runtime.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@monaco-editor/react": "4.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "1.2.0-beta.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serialport": "13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mioolio/blode.git"
  },
  "homepage": "https://github.com/mioolio/blode#readme",
  "bugs": {
    "url": "https://github.com/mioolio/blode/issues"
  },
  "license": "Apache-2.0"
}

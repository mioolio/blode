{
  "name": "blode-studio",
  "productName": "Blode Studio",
  "version": "0.1.0",
  "description": "Modular microcontroller development studio",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "postinstall": "node scripts/windows-runtime.mjs",
    "dev": "node scripts/dev.mjs",
    "repair:permissions": "node scripts/windows-runtime.mjs",
    "build": "npm run typecheck && node scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prestart": "node scripts/windows-runtime.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --win portable",
    "mcp": "tsx scripts/mcp-bridge.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@monaco-editor/react": "4.7.0",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serialport": "13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "studio.blode.desktop",
    "productName": "Blode Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "extensions/boards",
        "to": "boards",
        "filter": [
          "*/manifest.json"
        ]
      },
      {
        "from": "tools/STSW-LINK",
        "to": "drivers/STSW-LINK"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "portable"
    }
  }
}
